# --- Web app (public, safe for the browser) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Edge Function secrets (set with: pnpm sb secrets set --env-file supabase/.env.functions) ---
